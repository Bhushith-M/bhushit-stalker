# 1. OpenRouter (OpenAI-Compatible API) Configuration
# Uses OpenRouter API endpoint with your chosen model (default: openrouter/luna-6 or openai/gpt-4o-mini fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/luna-6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 2. Supabase Backend Configuration (Provide in Phase 5 or via in-app Settings Drawer)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_optional
